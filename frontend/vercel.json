{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://dietpi.tailf19567.ts.net:8443/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
